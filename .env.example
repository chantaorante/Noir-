# Copy to .env (chmod 600). Never commit .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=
NOIR_DATA_KEY=
# Comma-separated list of exact origins users will open, e.g. https://noir.lan,https://poker.example.com
PUBLIC_ORIGINS=https://noir.lan
NOIR_HOSTNAME=noir.lan
# "internal" for LAN self-signed CA, or an email address for a public domain with Let's Encrypt
NOIR_TLS=internal
# Optional, only with --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Backups: path to the age PUBLIC key (the private key must NOT live on this server)
BACKUP_AGE_RECIPIENT_FILE=/etc/noir/backup-recipient.txt
BACKUP_DIR=/var/backups/noir
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
